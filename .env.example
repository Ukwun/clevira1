# Configure the real unit price in Nigerian naira before publishing the offer.
# Leave blank until the official price is confirmed.
CLEVIRA_UNIT_PRICE_NGN=

# Lead notification delivery through Resend.
# The API returns an error rather than claiming success until these are set.
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=
LEADS_FROM_EMAIL=

# Optional: international number with digits only (country code included).
# Leave blank to open WhatsApp with a pre-filled message for the visitor to send.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: receive anonymous page and interaction events in your analytics/CRM workflow.
ACTIVITY_WEBHOOK_URL=
ACTIVITY_WEBHOOK_SECRET=
